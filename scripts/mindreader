#!/usr/bin/env bash
# Launcher: scripts/mindreader [app|doctor|train|eval|dictate] ...
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$DIR/third_party/silent-dictation/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "Run $DIR/scripts/bootstrap.sh first." >&2
  exit 1
fi
cd "$DIR"
PYTHONUNBUFFERED=1 exec "$PY" -m mindreader "$@"
